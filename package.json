{
  "name": "injectors-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "devsafe": "rimraf .next && next dev",
    "build": "tsx scripts/run-pre-push-migrations.ts && tsx scripts/db-push.ts && tsx scripts/run-migrations.ts && tsx scripts/setup-search-indexes.ts && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "db:push": "tsx scripts/db-push.ts",
    "db:backup": "tsx --env-file=.env.local scripts/db-backup.ts",
    "db:restore": "tsx --env-file=.env.local scripts/db-restore.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "import": "tsx --env-file=.env.local scripts/import-providers.ts",
    "import:reviews": "tsx --env-file=.env.local scripts/import-reviews.ts",
    "scan:alerts": "tsx --env-file=.env.local scripts/scan-data-alerts.ts",
    "scan:pages": "tsx --env-file=.env.local scripts/scan-pages.ts",
    "db:wipe": "tsx --env-file=.env.local scripts/wipe-data.ts",
    "seed:brands": "tsx --env-file=.env.local scripts/seed-brands.ts",
    "setup:search": "tsx --env-file=.env.local scripts/setup-search-indexes.ts",
    "notify:golive": "tsx --env-file=.env.local scripts/notify-go-live.ts",
    "seed:zips": "tsx --env-file=.env.local scripts/seed-zips.ts",
    "seed:dummy-clinics": "tsx --env-file=.env.local scripts/seed-dummy-clinics.ts",
    "backfill:zip-locations": "tsx --env-file=.env.local scripts/backfill-zip-locations.ts",
    "drip:index": "tsx --env-file=.env.local scripts/drip-index.ts",
    "rollup:analytics": "tsx --env-file=.env.local scripts/rollup-analytics.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@googlemaps/markerclusterer": "^2.5.3",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vis.gl/react-google-maps": "^1.5.5",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "geojson": "^0.5.0",
    "graphql": "^16.9.0",
    "gsap": "^3.15.0",
    "next": "~15.4.11",
    "next-themes": "^0.4.3",
    "payload": "3.90.2",
    "pg": "8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "~15.4.11",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20"
  }
}
